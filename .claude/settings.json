{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "defaultMode": "acceptEdits",
        "allow": [
            "PowerShell(cargo *)",
            "PowerShell(rustup *)",
            "PowerShell(npm *)",
            "PowerShell(npx *)",
            "PowerShell(node *)",
            "PowerShell(git status)",
            "PowerShell(git diff *)",
            "PowerShell(git log *)",
            "PowerShell(git add *)",
            "PowerShell(git commit *)",
            "Bash(cargo *)",
            "Bash(rustup *)",
            "Bash(npm *)",
            "Bash(npx *)",
            "Bash(node *)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git add *)",
            "Bash(git commit *)"
        ]
    }
}
